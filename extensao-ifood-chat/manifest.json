{
  "manifest_version": 3,
  "name": "Ortex – iFood Chat",
  "version": "1.0.0",
  "description": "Envia no chat do Gestor de Pedidos iFood as mensagens enfileiradas pelo CRM.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://gestordepedidos.ifood.com.br/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://gestordepedidos.ifood.com.br/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ortex – iFood Chat",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
